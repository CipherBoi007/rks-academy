# LOCAL DEVELOPMENT ONLY. For Render, generate the values with deploy/make-env.ps1 (see deploy/HOSTED.md).
# Run locally with SPRING_PROFILES_ACTIVE=dev; everything below then has a default.
SPRING_PROFILES_ACTIVE=dev

# Dev only: pins the business date so the seeded data matches the design screenshots. Ignored outside dev.
APP_DEMO_DATE=2026-11-05

# Local PostgreSQL (pgAdmin)
DB_URL=jdbc:postgresql://localhost:5432/rks_db
DB_USERNAME=postgres
DB_PASSWORD=root
DB_POOL_SIZE=10

# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`.
APP_JWT_SECRET=
APP_JWT_TTL=12h

APP_FRONTEND_ORIGIN=http://localhost:3000
# Empty locally. On a public host (Render) the web app must send the same value as BACKEND_PROXY_KEY.
APP_PROXY_KEY=
# Country code + number, digits only. Placeholder until the academy's real WhatsApp number is set.
APP_WHATSAPP_NUMBER=910000000000
APP_ACADEMY_PHONE=+91 00000 00000

# Month-start fee reminders. "log" never contacts anyone; "cloud" uses the WhatsApp Business Cloud API.
APP_WHATSAPP_PROVIDER=log
APP_WHATSAPP_PHONE_NUMBER_ID=
APP_WHATSAPP_ACCESS_TOKEN=
APP_WHATSAPP_TEMPLATE=fee_reminder
APP_WHATSAPP_LOGIN_TEMPLATE=login_code
APP_WHATSAPP_TEMPLATE_LANG=en
APP_REMINDERS_ENABLED=true
APP_REMINDERS_CRON=0 0 9 1 * *
