# Copy to .env on the server and fill in every value. Never commit .env.

# The site's domain. Point its DNS A record at the server first; Caddy then gets HTTPS automatically.
DOMAIN=app.rksacademy.in

# Database (stays on the private network).
POSTGRES_DB=rks
POSTGRES_USER=rks
# Long and random, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# Signs login sessions. At least 32 random characters: `openssl rand -base64 48`
APP_JWT_SECRET=

# The academy's WhatsApp number for "Enquire on WhatsApp" (country code + number, digits only).
APP_WHATSAPP_NUMBER=910000000000
APP_ACADEMY_PHONE=+91 00000 00000

# Fee reminders: "log" records without sending; switch to "cloud" once Meta has approved the template.
APP_WHATSAPP_PROVIDER=log
APP_WHATSAPP_PHONE_NUMBER_ID=
APP_WHATSAPP_ACCESS_TOKEN=
APP_WHATSAPP_TEMPLATE=fee_reminder
APP_WHATSAPP_TEMPLATE_LANG=en
APP_REMINDERS_ENABLED=true

# Backups
BACKUP_KEEP_DAYS=30
BACKUP_AT=02:30
